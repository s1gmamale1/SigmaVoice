# Dependencies
node_modules/
pnpm-lock.yaml

# Build output
sigma-dist/
release/

# Logs / OS cruft
*.log
.DS_Store

# Ruflo MCP — machine-local config (points CLAUDE_FLOW_DIR at the SHARED SigmaLink
# store, which is a machine-absolute path) + any local store dir. See CLAUDE.md
# "Shared Ruflo memory". Recreate per-machine; do not commit the absolute path.
.mcp.json
.claude-flow/
.swarm/
ruvector.db

# Agent worktrees (created by the Workflow tool for isolated parallel slices)
.claude/worktrees/

# Machine-local Claude/Cursor overrides (these embed absolute paths — same reason
# as .mcp.json above). The REST of .claude/ (agents, commands, skills, settings.json)
# is shareable project config and may be committed deliberately.
.claude/settings.local.json
.cursor/mcp.json
